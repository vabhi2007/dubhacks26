# Copy to .env at repo root. Never commit .env.  `pnpm check:env` verifies what's set.

# --- Required (core) ---
MONGODB_URI=                 # Atlas M0 connection string (mongodb+srv://...)
MONGODB_DB=alfred
ANTHROPIC_API_KEY=           # console.anthropic.com
ANTHROPIC_WORKSPACE_ID=      # only if the key isn't workspace-scoped (wrkspc_...)

# --- Required (integrations) ---
SERPAPI_KEY=                 # serpapi.com (free: 250/mo, 50/hr)
VOYAGE_API_KEY=              # Voyage AI embeddings (dashboard.voyageai.com or Atlas AI Models)
PERCEPTRON_API_KEY=          # Perceptron (Bearer token)
PERCEPTRON_BASE_URL=https://api.perceptron.inc/v1   # OpenAI-style /chat/completions, model perceptron-mk1.5
PHOTON_API_KEY=              # photon.co/beta dashboard -> project
PHOTON_PROJECT_ID=

# --- Optional ---
ATLAS_CHARTS_BASE_URL=       # Atlas Charts embed (unauthenticated embedding enabled)
ATLAS_CHARTS_SPEND_CHART_ID=
PUBLIC_TUNNEL_URL=           # cloudflared URL that forwards to :8787 (Photon webhooks)
RETELL_API_KEY=              # stretch: Photon Voice
ELEVENLABS_API_KEY=          # stretch: Photon Voice (pick one)

# --- Runtime flags ---
PRICE_SOURCE=mock            # live | cache | mock
VISION_SOURCE=claude         # perceptron | claude
MESSENGER=console            # photon | console
AGENT_PORT=8787
AGENT_URL=http://localhost:8787
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
WXT_AGENT_URL=http://localhost:8787
DEMO_USER_ID=u_maya
